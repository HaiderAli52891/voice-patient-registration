# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Core -----------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Public HTTPS URL of this service. ngrok URL locally, app URL in production.
PUBLIC_BASE_URL=https://your-app.up.railway.app

# Database -------------------------------------------------------------------
# SQLite by default. Swap for Postgres in production:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/patients
DATABASE_URL=sqlite:///./data/patients.db

# LLM ------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Telephony (Twilio) ---------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_VOICE=Polly.Joanna-Neural
# Set true once deployed behind HTTPS to reject forged webhooks.
VALIDATE_TWILIO_SIGNATURE=false

# Vapi / Retell (only if using Option B) -------------------------------------
VAPI_SECRET=

# Dashboard ------------------------------------------------------------------
# Leave blank for a public dashboard; set both to require HTTP Basic auth.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
